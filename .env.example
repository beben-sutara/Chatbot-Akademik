# Application
APP_ENV=development
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database — Supabase PostgreSQL connection
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
# Use the "Transaction pooler" URI for production (port 6543) or
# "Session pooler" / direct connection for development (port 5432).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase project credentials
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600

# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Chatbot Akademik

# CORS (comma-separated list of allowed origins, use * for all)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
